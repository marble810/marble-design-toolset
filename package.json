{
	"name": "marbledesigntoolset.github.io",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "bun ./scripts/build-web-catalog.ts && vite dev",
		"build": "bun ./scripts/build-web-catalog.ts && vite build",
		"forge:web-catalog": "bun ./scripts/build-web-catalog.ts",
		"smoke:web-adapter": "bun ./scripts/smoke-web-adapter.mjs",
		"dev:desktop": "bun run --cwd apps/desktop app:dev",
		"test": "bun test",
		"typecheck": "tsc --noEmit -p tsconfig.packages.json && tsc --noEmit -p apps/desktop",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22.10.2",
		"mdsvex": "^0.12.7",
		"puppeteer-core": "^25.9.0",
		"rehype-highlight": "^7.0.2",
		"svelte": "^5.55.2",
		"typescript": "^5.7.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"bits-ui": "^2.17.3",
		"fast-png": "^7.0.0",
		"geist": "^1.7.0",
		"gsap": "^3.14.2",
		"html-to-image": "^1.11.13",
		"pixelarticons": "^2.0.2",
		"pixi.js": "^8.17.1",
		"three": "^0.183.2",
		"tool-builder": "workspace:*",
		"tool-contract": "workspace:*",
		"tool-host": "workspace:*",
		"tool-sdk": "workspace:*"
	}
}
